# Copy to .env.local for development. Set the same variables in Vercel for deployment.
# Never commit a real password or signing key.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here

# Strong, unique password for protected pages/routes (at least 16 characters).
PAGE_ACCESS_PASSWORD=

# Key that signs the access cookie (any long random string, e.g. `openssl rand -base64 32`).
# Optional: without it a key derived from PAGE_ACCESS_PASSWORD is used.
# Changing either value revokes existing access cookies.
PAGE_ACCESS_SECRET=
